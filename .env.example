PORT=3000
BASE_URL=http://localhost:3000        # آدرس عمومی سایت (برای بازگشت از درگاه و IPN باید دامنهٔ واقعی باشد)
USD_IRR=600000                        # نرخ هر دلار به ریال - خودتان به‌روز کنید

# درگاه ریالی - زرین‌پال
ZARINPAL_MERCHANT=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=1                    # برای تست 1، برای واقعی حذف یا 0

# درگاه دلاری - ارز دیجیتال (NOWPayments)
NOWPAYMENTS_KEY=
NOWPAYMENTS_IPN_SECRET=

# پنل ادمین (آدرس: /admin) — رمز حداقل ۱۰ کاراکتر؛ در production بدون آن سرور بالا نمی‌آید
ADMIN_USER=Admin
ADMIN_PASS=

# عملیاتی
NODE_ENV=development                  # روی سرور واقعی: production
TRUST_PROXY=0                         # پشت Nginx/Cloudflare برابر 1
# DB_FILE=/data/orders.db
